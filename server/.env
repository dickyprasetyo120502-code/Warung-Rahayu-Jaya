# Environment Variables - Warung Rahayu Jaya Backend
PORT=5000
NODE_ENV=development

# Konfigurasi Database PostgreSQL LOCAL (Bukan Supabase/Neon/Firebase/Cloud)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/warung_rahayu_jaya?schema=public"

# Secret Key untuk otentikasi JSON Web Token (JWT)
JWT_SECRET="warung_rahayu_jaya_jwt_secret_super_secure_key_2026"
JWT_EXPIRES_IN="1d"

