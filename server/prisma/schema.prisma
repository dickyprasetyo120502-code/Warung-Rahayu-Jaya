// Schema Prisma untuk Warung Rahayu Jaya
// Menggunakan PostgreSQL & terhubung dengan DBeaver

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Model Pengguna (Admin & Kasir)
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Plain text untuk demo atau bcrypt hash
  role      String   @default("KASIR") // "ADMIN" atau "KASIR"
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// 2. Kategori Menu (Makanan, Minuman, Paket Hemat)
model Category {
  id        String     @id // e.g. "makanan", "minuman", "paket"
  title     String
  items     MenuItem[]
  createdAt DateTime   @default(now())

  @@map("categories")
}

// 3. Item Menu & Stok Real-Time
model MenuItem {
  id          String      @id // e.g. "ayam-goreng", "ayam-bakar"
  nama        String
  harga       Int
  deskripsi   String?
  gambar      String?
  stock       Int         @default(20) // Stok bahan / porsi di dapur
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("menu_items")
}

// 4. Data Pesanan / Transaksi Kasir
model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique // e.g. "WRJ-001", "WRJ-002"
  orderType     String      @default("dine-in") // "dine-in" atau "take-away"
  tableNumber   String?     // null jika take-away
  guestCount    String?
  nama          String      // Nama pemesan
  telepon       String?     // Nomor WhatsApp customer untuk kirim PDF nota
  catatan       String?
  subtotal      Int
  tax           Int         // PB1 10%
  total         Int         // Total Akhir
  paymentMethod String      @default("qris") // "qris", "cash", "edc"
  paymentStatus String      @default("PAID") // "PENDING", "PAID", "CANCELLED"
  kasirName     String?     @default("Kasir")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

// 5. Rincian Item di dalam Pesanan
model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  nama       String
  harga      Int
  qty        Int
  total      Int

  @@map("order_items")
}

